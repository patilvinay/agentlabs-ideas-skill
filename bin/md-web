#!/usr/bin/env bash
# Show this pane's session in the browser. tmux prefix + w.
#
#   md-web [PANE_ID]
#
# One window per session, never a jump to another workspace. If this
# session's md-server window is on the workspace you are on, it is raised;
# otherwise a new browser window opens here. Windows do not follow other
# sessions' keypresses, so each keeps showing its own session. Finding the
# window needs wmctrl; without it a new window opens every time.
set -uo pipefail
port="${MD_WEB_PORT:-7677}"
srv="$HOME/.local/bin/md-server"
log="${XDG_RUNTIME_DIR:-/tmp}/md-server.log"

# Resolve first, THEN test. `basename ""` succeeds and prints nothing, so the
# old one-liner form let a failed session-dir through as an empty sid and opened
# /s/ -- a wrong page rather than an error.
dir=$(session-dir "${1:-${TMUX_PANE:-}}" 2>/dev/null)
sid=$(basename "$dir")
[ -n "$dir" ] && [ -n "$sid" ] && [ "$sid" != "." ] || {
  echo "md-web: no session for this pane (${1:-${TMUX_PANE:-no pane}})" >&2; exit 1; }

up() { (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null; }

if ! up; then
  setsid "$srv" --port "$port" >"$log" 2>&1 &
  for _ in $(seq 40); do up && break; sleep 0.1; done
fi

url="http://127.0.0.1:$port/s/$sid"
[ -n "${MD_WEB_PRINT:-}" ] && { printf '%s\n' "$url"; exit 0; }

# Tell the server this session's pane directory (its sidebar lists it).
cwd=$(tmux display -p -t "${1:-}" '#{pane_current_path}' 2>/dev/null || pwd)
curl -s --max-time 2 --get -o /dev/null \
     --data-urlencode "sid=$sid" --data-urlencode "cwd=$cwd" \
     "http://127.0.0.1:$port/api/focus" || true

# This session's md-server window on the current workspace, if any. Windows
# stay on the session they show (one per session), so only ours may be raised:
# page titles are "<session> · md-server" or "<file> · <session> · md-server".
# wmctrl -a by title would jump workspaces; activate by id, and only if here.
here_window() {
  command -v wmctrl >/dev/null || return 1
  local cur; cur=$(wmctrl -d 2>/dev/null | awk '$2=="*"{print $1; exit}')
  [ -n "$cur" ] || return 1
  wmctrl -l 2>/dev/null | awk -v d="$cur" -v t="$1" '
    ($2==d || $2==-1) {
      title=$0; for (i=1; i<=3; i++) sub(/^[^ ]+ +/, "", title)
      if (index(title, t " · md-server") == 1 || index(title, " · " t " · md-server")) { print $1; exit }
    }' | grep .
}

title=$(session-title "$sid" 2>/dev/null || echo "$sid")
if win=$(here_window "$title"); then
  # This session's page is already open here: bring it forward.
  wmctrl -i -a "$win" 2>/dev/null || true
  tmux display-message "browser tab → $title" 2>/dev/null || true
else
  # Not open on this workspace: open a new window right here. The
  # default browser (chrome-link-here.desktop) opens links with --new-window,
  # which lands on the current workspace.
  command -v xdg-open >/dev/null && xdg-open "$url" >/dev/null 2>&1 &
  tmux display-message "opened browser → $title" 2>/dev/null || true
fi
printf '%s\n' "$url"
